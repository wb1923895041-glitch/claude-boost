{
  "claude-boost-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [{ "type": "command", "command": "node hooks/guard.mjs", "timeout": 10 }]
      }
    ]
  },
  "claude-boost-checkpoint": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|write_file|edit_file",
        "hooks": [{ "type": "command", "command": "node hooks/checkpoint.mjs", "timeout": 15 }]
      }
    ]
  },
  "claude-boost-autocheck": {
    "PreInvocation": [
      { "type": "command", "command": "node hooks/pre-invocation.mjs", "timeout": 10 }
    ]
  },
  "claude-boost-memory": {
    "SessionStart": [
      { "type": "command", "command": "node hooks/session-start.mjs", "timeout": 10 }
    ]
  },
  "claude-boost-verify": {
    "Stop": [
      { "type": "command", "command": "node hooks/stop.mjs", "timeout": 30 }
    ]
  }
}
